{
  "name": "altronic-arc",
  "private": true,
  "version": "0.204.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "ARC — Altronic Resource Center: a company-wide, SharePoint-backed platform unifying every department's tools (Engineering first)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
